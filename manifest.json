{
  "manifest_version": 3,
  "name": "Z.AI Local Time",
  "version": "1.0.0",
  "description": "Shows Z.AI Coding Plan reset times in your local time zone and tells you when the GLM-5.3-Flash promo window is active.",
  "permissions": ["storage", "alarms"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Z.AI Local Time" },
  "content_scripts": [
    {
      "matches": ["https://z.ai/*", "https://*.z.ai/*"],
      "js": ["promo.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
